---
import "../../styles/contact.css";
import { copy, type Locale } from "../../i18n";
import { siteConfig } from "../../data/site";
import Icon from "../icons/Icon.astro";
interface Props {
  locale: Locale;
  standalone?: boolean;
}
const { locale, standalone = false } = Astro.props;
const t = copy[locale];
const Heading = standalone ? "h1" : "h2";
---

<section
  class:list={["contact-section", { "contact-standalone": standalone }]}
  id="contact"
  aria-labelledby="contact-title"
>
  <div class="container contact-inner">
    <div class="section-label">
      <span>{standalone ? "↗" : "04 /"}</span>
      {t.contact}
    </div>
    <div class="contact-main">
      <Heading id="contact-title">
        {t.contactTitle}
        <span class="contact-arrow" aria-hidden="true">
          ↗
        </span>
      </Heading>
      <p>{t.contactIntro}</p>
      <div class="email-row">
        <a class="email-link" href={`mailto:${siteConfig.email}`}>
          {siteConfig.email}
        </a>
        <button
          class="icon-button copy-email"
          type="button"
          data-copy-email={siteConfig.email}
          aria-label={t.copyEmail}
          title={t.copyEmail}
        >
          <Icon name="copy" size={20} />
        </button>
      </div>
      <p
        class="copy-feedback"
        role="status"
        aria-live="polite"
        data-copy-feedback
      ></p>
      <div class="contact-links">
        <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
          <Icon name="external-link" size={19} />
        </a>
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">
          GitHub
          <Icon name="external-link" size={19} />
        </a>
        <a
          href={siteConfig.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.resume}
          <Icon name="external-link" size={19} />
          <span class="resume-note">{t.resumeNote}</span>
        </a>
      </div>
      <div class="contact-details">
        <span>
          <Icon name="pin" size={16} />
          {t.contactLocation}
        </span>
        <span>{t.contactLanguages}</span>
      </div>
    </div>
  </div>
</section>
