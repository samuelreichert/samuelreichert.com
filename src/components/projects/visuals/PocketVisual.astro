---
import "../../../styles/projects/pocket.css";
import { copy, type Locale } from "../../../i18n";
interface Props {
  locale: Locale;
}
const t = copy[Astro.props.locale].illustrations.reading;
---

<div class="reading-sheet sheet-back"></div>
<div class="reading-sheet">
  <div class="reading-brand">
    <span class="pocket-symbol">⌄</span>pocket clone
  </div>
  <div class="reading-divider"></div>
  <span class="reading-kicker">{t.kicker}</span>
  <div class="reading-art">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <b>{t.title}</b>
  <div class="reading-meta">
    React Native<span>·</span>6 min
  </div>
  <div class="reading-lines">
    <i></i>
    <i></i>
  </div>
</div>
