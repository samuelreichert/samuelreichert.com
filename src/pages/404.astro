---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/not-found.css";
---

<BaseLayout title="404 — Samuel Reichert" noindex>
  <section class="container not-found">
    <span class="section-label">404</span>
    <h1 data-not-found-title>Page not found.</h1>
    <p data-not-found-body>This address doesn’t match a page on the site.</p>
    <a class="button button-primary" href="/en" data-not-found-home>
      Back to home
    </a>
  </section>
</BaseLayout>
